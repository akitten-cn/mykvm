{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MyKVM Local",
  "version": "0.1.3",
  "identifier": "local.mykvm.gaming",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node scripts/build-tauri-assets.mjs"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {}
  },
  "plugins": {},
  "mainBinaryName": "mykvm-local"
}
